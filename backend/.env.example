# Copia este archivo como .env y cambia los valores. El .env nunca se sube al repositorio.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5183

POSTGRES_DB=finanzas
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=cambia-esta-clave
# 127.0.0.1 y no "localhost": en Windows "localhost" prueba antes IPv6 y cada consulta tarda segundos
POSTGRES_HOST=127.0.0.1
# Debe coincidir con el puerto publicado en docker-compose.yml
POSTGRES_PORT=5434

THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=5/min
# Proxies de confianza delante de Django. 0 en desarrollo; en producción, los que
# haya entre el navegador y Django (Vercel y Railway: spec 012).
NUM_PROXIES=0

# Contraseña de los usuarios de ejemplo que crea `python manage.py seed_demo`.
# Solo para desarrollo: el comando se niega a funcionar con DEBUG=False.
DEMO_PASSWORD=cambia-esta-clave-de-ejemplo
